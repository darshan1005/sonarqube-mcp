{
  "name": "sonarqube-rest-api-mcp",
  "displayName": "SonarQube REST API MCP",
  "description": "Connect VS Code to a remote SonarQube REST API MCP server.",
  "version": "0.1.0",
  "publisher": "BDarshan1052",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/darshan1005/sonarqube-mcp.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "sonarqube",
    "mcp",
    "model-context-protocol",
    "code-quality",
    "copilot"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "sonarqube-mcp.provider",
        "label": "SonarQube MCP"
      }
    ],
    "commands": [
      {
        "command": "sonarqubeMcp.configure",
        "title": "SonarQube MCP: Configure"
      },
      {
        "command": "sonarqubeMcp.testConnection",
        "title": "SonarQube MCP: Test Connection"
      },
      {
        "command": "sonarqubeMcp.clearCredentials",
        "title": "SonarQube MCP: Clear Credentials"
      },
      {
        "command": "sonarqubeMcp.showStatus",
        "title": "SonarQube MCP: Show Status"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check extension.js",
    "package": "npx --yes @vscode/vsce package"
  }
}
