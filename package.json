{
  "name": "sonarqube-mcp",
  "displayName": "SonarQube MCP",
  "description": "Connect VS Code to a remote SonarQube MCP server over Streamable HTTP.",
  "version": "0.1.0",
  "publisher": "darshan1005",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/darshan1005/sonarqube-mcp.git"
  },
  "engines": {
    "vscode": ">=1.102.0"
  },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:sonarqubeMcp.configure",
    "onCommand:sonarqubeMcp.testConnection",
    "onCommand:sonarqubeMcp.clearCredentials",
    "onCommand:sonarqubeMcp.showStatus"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "sonarqube-mcp.provider",
        "label": "SonarQube MCP"
      }
    ],
    "commands": [
      { "command": "sonarqubeMcp.configure", "title": "SonarQube MCP: Configure" },
      { "command": "sonarqubeMcp.testConnection", "title": "SonarQube MCP: Test Connection" },
      { "command": "sonarqubeMcp.clearCredentials", "title": "SonarQube MCP: Clear Credentials" },
      { "command": "sonarqubeMcp.showStatus", "title": "SonarQube MCP: Show Status" }
    ]
  },
  "scripts": {
    "check": "node --check extension.js"
  }
}
