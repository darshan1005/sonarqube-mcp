PORT=3000
HOST=0.0.0.0
SONAR_URL=https://sonarqube.example.com
# JSON array. Use tokenHash (SHA-256 hex/base64url) in production; token is supported only for opaque env secrets.
SONAR_USERS_JSON=[{"id":"alice","tokenHash":"<sha256-of-mcp-token>","sonarToken":"<alice-sonarqube-token>"}]
# Optional limits/timeouts
MAX_BODY_BYTES=1048576
SONAR_TIMEOUT_MS=10000
MAX_PAGE_SIZE=100
